# Copy to .env.production, restrict file permissions to deployment operator only.
POSTGRES_DB=flowdesk
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
MINIO_ROOT_USER=flowdesk-storage-admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
WEB_PORT=8080
VITE_API_URL=/api/v1
METRICS_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_TOKEN
S3_ACCESS_KEY_ID=flowdesk-app-storage
S3_SECRET_ACCESS_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# OpenRouter (server-side API only; never a VITE_ variable)
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_API_KEY=
AI_INCLUDE_WORKSPACE_CONTEXT=false

NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://app.example.com
APP_URL=https://app.example.com
COOKIE_NAME=__Host-flowdesk_session
TRUST_PROXY=true
SESSION_TTL_DAYS=14
# Set by compose; shown here to document required secret names.
DATABASE_URL=
REDIS_URL=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=flowdesk-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FlowDesk <no-reply@example.com>
TOTP_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# OpenRouter free model configuration (server-side only).
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_API_KEY=
AI_INCLUDE_WORKSPACE_CONTEXT=false

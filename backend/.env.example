NODE_ENV=development
TRUST_PROXY=false
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://flowdesk:change-me@localhost:5432/flowdesk?schema=public
SESSION_TTL_DAYS=14
COOKIE_NAME=flowdesk_session # Production: __Host-flowdesk_session (HTTPS required)
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FlowDesk <no-reply@example.com>
TOTP_ENCRYPTION_KEY=generate-a-64-character-hex-string-with-openssl-rand-hex-32
# OpenRouter credentials are server-only. Never expose these through VITE_* variables.
# Create a key at https://openrouter.ai/settings/keys and store it only on the API server.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_API_KEY=
# Free upstream model endpoints may use prompts to improve provider services.
# Keep false for production unless you have reviewed the provider terms and approved sharing workspace records.
AI_INCLUDE_WORKSPACE_CONTEXT=false
# Workspace storage quota (default 512 MiB)
WORKSPACE_STORAGE_LIMIT_BYTES=536870912

# Stripe billing (server-side only). Configure both before enabling checkout/webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Shared production protections (required in production)
REDIS_URL=redis://:url-safe-password@localhost:6379/0
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=flowdesk-files
S3_ACCESS_KEY_ID=flowdesk-app
S3_SECRET_ACCESS_KEY=
METRICS_TOKEN=generate-at-least-32-random-characters
# Docker/Kubernetes secret files may be supplied as DATABASE_URL_FILE, REDIS_URL_FILE,
# SMTP_PASSWORD_FILE, TOTP_ENCRYPTION_KEY_FILE, STRIPE_SECRET_KEY_FILE,
# STRIPE_WEBHOOK_SECRET_FILE, AI_API_KEY_FILE, S3_SECRET_ACCESS_KEY_FILE or METRICS_TOKEN_FILE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}
enum PlatformRole {
  USER
  SUPPORT
  ADMIN
  SUPER_ADMIN
}
enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}
enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model User {
  id                    String                    @id @default(cuid())
  name                  String
  avatarUrl             String?
  bio                   String?
  timezone              String?
  email                 String                    @unique
  passwordHash          String
  emailVerifiedAt       DateTime?
  status                UserStatus                @default(PENDING_VERIFICATION)
  platformRole          PlatformRole              @default(USER)
  twoFactorEnabled      Boolean                   @default(false)
  twoFactorSecret       String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  sessions              Session[]
  recoveryCodes         TwoFactorRecoveryCode[]
  verificationTokens    EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  memberships           WorkspaceMember[]
  sentInvitations       WorkspaceInvitation[] @relation("InvitationInviter")
  acceptedInvitations   WorkspaceInvitation[] @relation("InvitationAccepter")
  createdProjects       Project[] @relation("ProjectCreator")
  assignedProjects      Project[] @relation("ProjectAssignee")
  ownedWorkspaces       Workspace[] @relation("WorkspaceOwner")
  auditEvents           AuditEvent[]              @relation("AuditActor")
  assignedTasks         Task[]                    @relation("TaskAssignee")
  taskComments          TaskComment[]
  notifications         Notification[]
  customerActivities    CustomerActivity[]
  recordedPayments     Payment[]                 @relation("PaymentRecorder")
  aiConversations      AiConversation[]
  uploadedFiles       FileAsset[] @relation("FileUploader")
  notificationPreference NotificationPreference?
  preferences UserPreference?
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}

model Workspace {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  description String?
  logoUrl   String?
  ownerId   String?
  owner     User?            @relation("WorkspaceOwner", fields:[ownerId], references:[id], onDelete:SetNull)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  status WorkspaceStatus @default(ACTIVE)
  suspendedAt DateTime?
  members   WorkspaceMember[]
  invitations WorkspaceInvitation[]
  projects Project[]
  tasks Task[]
  customers Customer[]
  invoices Invoice[]
  events CalendarEvent[]
  notifications Notification[]
  expenses Expense[]
  files FileAsset[]
  aiConversations AiConversation[]
  subscription WorkspaceSubscription?
  billingCustomer BillingCustomer?
  billingInvoices BillingInvoice[]
  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
  @@index([userId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
}

model TwoFactorRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, codeHash])
  @@index([userId])
}


enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}
enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}
enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model WorkspaceInvitation {
  id String @id @default(cuid())
  workspaceId String
  email String
  role WorkspaceRole @default(MEMBER)
  tokenHash String @unique
  status InvitationStatus @default(PENDING)
  inviterId String
  accepterId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  acceptedAt DateTime?
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  inviter User @relation("InvitationInviter", fields:[inviterId], references:[id], onDelete:Cascade)
  accepter User? @relation("InvitationAccepter", fields:[accepterId], references:[id], onDelete:SetNull)
  @@index([workspaceId,email,status])
  @@index([email,status])
  @@index([workspaceId,status])
}

model Project {
  id String @id @default(cuid())
  workspaceId String
  name String
  description String?
  status ProjectStatus @default(PLANNING)
  priority ProjectPriority @default(MEDIUM)
  startDate DateTime?
  dueDate DateTime?
  budget Decimal? @db.Decimal(14,2)
  currency String @default("USD")
  progress Int @default(0)
  archivedAt DateTime?
  createdById String
  assigneeId String?
  customerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  customer Customer? @relation(fields:[customerId], references:[id], onDelete:SetNull)
  creator User @relation("ProjectCreator", fields:[createdById], references:[id], onDelete:Restrict)
  assignee User? @relation("ProjectAssignee", fields:[assigneeId], references:[id], onDelete:SetNull)
  milestones ProjectMilestone[]
  activities ProjectActivity[]
  tasks Task[]
  @@index([workspaceId,status])
  @@index([workspaceId,dueDate])
  @@index([assigneeId])
}

model ProjectMilestone {
  id String @id @default(cuid())
  projectId String
  title String
  description String?
  dueDate DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  project Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  @@index([projectId,dueDate])
}

model ProjectActivity {
  id String @id @default(cuid())
  projectId String
  actorId String?
  action String
  details Json?
  createdAt DateTime @default(now())
  project Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  @@index([projectId,createdAt])
}

model Task {
  id String @id @default(cuid())
  workspaceId String
  projectId String?
  parentId String?
  title String
  description String?
  status TaskStatus @default(TODO)
  priority ProjectPriority @default(MEDIUM)
  dueDate DateTime?
  startDate DateTime?
  estimatedMinutes Int?
  assigneeId String?
  completedAt DateTime?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  project Project? @relation(fields:[projectId], references:[id], onDelete:SetNull)
  assignee User? @relation("TaskAssignee", fields:[assigneeId], references:[id], onDelete:SetNull)
  parent Task? @relation("TaskSubtasks", fields:[parentId], references:[id], onDelete:Cascade)
  subtasks Task[] @relation("TaskSubtasks")
  dependencies TaskDependency[] @relation("TaskDependencyTarget")
  dependents TaskDependency[] @relation("TaskDependencySource")
  comments TaskComment[]
  attachments TaskAttachment[]
  @@index([workspaceId,status])
  @@index([workspaceId,dueDate])
  @@index([workspaceId,assigneeId])
  @@index([projectId])
  @@index([parentId])
}
model TaskDependency {
  id String @id @default(cuid())
  predecessorId String
  successorId String
  createdAt DateTime @default(now())
  predecessor Task @relation("TaskDependencySource", fields:[predecessorId], references:[id], onDelete:Cascade)
  successor Task @relation("TaskDependencyTarget", fields:[successorId], references:[id], onDelete:Cascade)
  @@unique([predecessorId,successorId])
  @@index([successorId])
}
model TaskComment {
  id String @id @default(cuid())
  taskId String
  authorId String
  body String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task Task @relation(fields:[taskId], references:[id], onDelete:Cascade)
  author User @relation(fields:[authorId], references:[id], onDelete:Cascade)
  @@index([taskId,createdAt])
}
model TaskAttachment {
  id String @id @default(cuid())
  taskId String
  name String
  url String
  mimeType String?
  sizeBytes Int?
  uploadedById String
  createdAt DateTime @default(now())
  task Task @relation(fields:[taskId], references:[id], onDelete:Cascade)
  @@index([taskId])
}
model Notification {
  id String @id @default(cuid())
  userId String
  workspaceId String
  type String
  title String
  body String?
  entityType String?
  entityId String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@index([userId,readAt,createdAt])
  @@index([workspaceId,createdAt])
}

model Customer {
  id String @id @default(cuid())
  workspaceId String
  name String
  email String?
  company String?
  phone String?
  category String?
  address String?
  website String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  notesHistory CustomerNote[]
  activities CustomerActivity[]
  invoices Invoice[]
  projects Project[]
  @@index([workspaceId,name])
  @@index([workspaceId,email])
  @@index([workspaceId,category])
}
model CustomerNote {
  id String @id @default(cuid())
  customerId String
  body String
  createdById String
  createdAt DateTime @default(now())
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Cascade)
  @@index([customerId,createdAt])
}
model CustomerActivity {
  id String @id @default(cuid())
  customerId String
  actorId String?
  type String
  summary String
  details Json?
  occurredAt DateTime @default(now())
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Cascade)
  actor User? @relation(fields:[actorId], references:[id], onDelete:SetNull)
  @@index([customerId,occurredAt])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}
model Invoice {
  id String @id @default(cuid())
  workspaceId String
  customerId String?
  customerName String
  number String
  currency String @default("USD")
  status InvoiceStatus @default(DRAFT)
  issueDate DateTime @default(now())
  dueDate DateTime?
  subtotal Decimal @default(0) @db.Decimal(14,2)
  discount Decimal @default(0) @db.Decimal(14,2)
  taxRate Decimal @default(0) @db.Decimal(7,4)
  taxAmount Decimal @default(0) @db.Decimal(14,2)
  total Decimal @default(0) @db.Decimal(14,2)
  amount Decimal @default(0) @db.Decimal(14,2)
  notes String?
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  customer Customer? @relation(fields:[customerId], references:[id], onDelete:SetNull)
  items InvoiceLineItem[]
  payments Payment[]
  @@unique([workspaceId,number])
  @@index([workspaceId,status,dueDate])
  @@index([customerId])
}
model InvoiceLineItem {
  id String @id @default(cuid())
  invoiceId String
  description String
  quantity Decimal @default(1) @db.Decimal(12,3)
  unitPrice Decimal @db.Decimal(14,2)
  amount Decimal @db.Decimal(14,2)
  invoice Invoice @relation(fields:[invoiceId], references:[id], onDelete:Cascade)
  @@index([invoiceId])
}
model Payment {
  id String @id @default(cuid())
  invoiceId String
  amount Decimal @db.Decimal(14,2)
  currency String
  method String?
  reference String?
  paidAt DateTime @default(now())
  recordedById String?
  invoice Invoice @relation(fields:[invoiceId], references:[id], onDelete:Cascade)
  recorder User? @relation("PaymentRecorder", fields:[recordedById], references:[id], onDelete:SetNull)
  @@index([invoiceId,paidAt])
}
model Expense {
  id String @id @default(cuid())
  workspaceId String
  description String
  category String?
  amount Decimal @db.Decimal(14,2)
  currency String @default("USD")
  incurredAt DateTime @default(now())
  vendor String?
  reference String?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@index([workspaceId,incurredAt])
}

model CalendarEvent {
  id String @id @default(cuid())
  workspaceId String
  title String
  description String?
  startsAt DateTime
  endsAt DateTime?
  allDay Boolean @default(false)
  recurrenceRule String?
  reminderMinutes Int?
  sourceType String?
  sourceId String?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  reminders CalendarReminder[]
  @@index([workspaceId,startsAt])
}
model CalendarReminder {
  id String @id @default(cuid())
  eventId String
  remindAt DateTime
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  event CalendarEvent @relation(fields:[eventId], references:[id], onDelete:Cascade)
  @@index([remindAt,deliveredAt])
}


model AiConversation {
  id String @id @default(cuid())
  workspaceId String
  userId String
  title String @default("New conversation")
  provider String
  model String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  messages AiMessage[]
  @@index([workspaceId,userId,updatedAt])
}
model AiMessage {
  id String @id @default(cuid())
  conversationId String
  role String
  content String @db.Text
  inputTokens Int?
  outputTokens Int?
  createdAt DateTime @default(now())
  conversation AiConversation @relation(fields:[conversationId], references:[id], onDelete:Cascade)
  @@index([conversationId,createdAt])
}
model AiUsage {
  id String @id @default(cuid())
  workspaceId String
  userId String
  provider String
  model String
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  estimatedCost Decimal? @db.Decimal(12,6)
  createdAt DateTime @default(now())
  @@index([workspaceId,createdAt])
  @@index([userId,createdAt])
}
model NotificationPreference {
  id String @id @default(cuid())
  userId String @unique
  inApp Boolean @default(true)
  email Boolean @default(true)
  taskReminders Boolean @default(true)
  projectUpdates Boolean @default(true)
  invoiceReminders Boolean @default(true)
  workspaceInvitations Boolean @default(true)
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}
model FileAsset {
  id String @id @default(cuid())
  workspaceId String
  uploaderId String
  originalName String
  storageName String @unique
  mimeType String
  sizeBytes Int
  checksum String
  entityType String?
  entityId String?
  deletedAt DateTime?
  purgeAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  uploader User @relation("FileUploader", fields:[uploaderId], references:[id], onDelete:Restrict)
  @@index([workspaceId,deletedAt,createdAt])
  @@index([entityType,entityId])
}


model UserPreference {
  id String @id @default(cuid())
  userId String @unique
  theme String @default("system")
  locale String @default("en")
  dateFormat String @default("DD/MM/YYYY")
  weekStartsOn Int @default(1)
  compactMode Boolean @default(false)
  emailDigest String @default("daily")
  productUpdates Boolean @default(false)
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}

model PlatformSetting {
  key String @id
  value Json
  updatedAt DateTime @updatedAt
  updatedById String?
}


enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  EXPIRED
}

model WorkspaceSubscription {
  id String @id @default(cuid())
  workspaceId String @unique
  planCode String
  status SubscriptionStatus @default(INCOMPLETE)
  billingInterval String @default("month")
  provider String @default("stripe")
  providerCustomerId String? @unique
  providerSubscriptionId String? @unique
  providerPriceId String?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  canceledAt DateTime?
  trialEndsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@index([status,currentPeriodEnd])
}

model BillingCustomer {
  id String @id @default(cuid())
  workspaceId String @unique
  email String?
  name String?
  provider String @default("stripe")
  providerCustomerId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
}

model BillingInvoice {
  id String @id @default(cuid())
  workspaceId String
  providerInvoiceId String? @unique
  number String?
  status String
  currency String @default("usd")
  amountDue Int @default(0)
  amountPaid Int @default(0)
  hostedUrl String?
  invoicePdfUrl String?
  periodStart DateTime?
  periodEnd DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  payments BillingPayment[]
  @@index([workspaceId,createdAt])
}

model BillingPayment {
  id String @id @default(cuid())
  invoiceId String
  providerPaymentId String? @unique
  status String
  amount Int
  currency String @default("usd")
  paidAt DateTime?
  createdAt DateTime @default(now())
  invoice BillingInvoice @relation(fields:[invoiceId], references:[id], onDelete:Cascade)
  @@index([invoiceId,status])
}

model BillingWebhookEvent {
  id String @id @default(cuid())
  providerEventId String @unique
  eventType String
  processedAt DateTime @default(now())
}
